GEMINI_API_KEY=sua_chave_aqui

# Modelo simples/barato para chamadas rotineiras e lotes pequenos.
MODEL_SIMPLE=gemini-2.5-flash-lite

# Modelo de maior capacidade/contexto para prompts grandes e fallback.
MODEL_CONTEXT=gemini-2.5-pro

# Compatibilidade com versões anteriores do projeto.
MODEL_FLASH=gemini-2.5-flash-lite
MODEL_PRO=gemini-2.5-pro

MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=240
CONTEXT_MODEL_MIN_CHARS=90000

MAX_PAGES_BEGIN=30
MAX_PAGES_END=10
MAX_CHARS_PER_CHUNK=100000
CHUNK_OVERLAP=3000
PAUSE_BETWEEN_CALLS=3.0

AI_DICTIONARY_BATCH_SIZE=50
AI_APPLY_MIN_CONFIDENCE=alta
AI_DICTIONARY_RESUME=true
AI_DICTIONARY_FORCE_REPROCESS=false
